<Window x:Class="Lab15_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Однорукий бандит" 
        Height="500" Width="800" 
        WindowStartupLocation="CenterScreen"
        Background="OrangeRed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="ОДНОРУКИЙ БАНДИТ (ВАРИАНТ 13)" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="10"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    BorderBrush="Black" 
                    BorderThickness="2" 
                    Margin="5" 
                    Padding="10"
                    Background="LightGray">
                <TextBlock x:Name="Reel1" 
                           Text="0" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
            </Border>

            <Border Grid.Column="1" 
                    BorderBrush="Black" 
                    BorderThickness="2" 
                    Margin="5" 
                    Padding="10"
                    Background="LightGray">
                <TextBlock x:Name="Reel2" 
                           Text="0" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
            </Border>

            <Border Grid.Column="2" 
                    BorderBrush="Black" 
                    BorderThickness="2" 
                    Margin="5" 
                    Padding="10"
                    Background="LightGray">
                <TextBlock x:Name="Reel3" 
                           Text="0" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnSpin" Content="КРУТИТЬ" Width="100" Height="40" Margin="5" Click="BtnSpin_Click"/>
            <Button x:Name="btnStop" Content="СТОП" Width="100" Height="40" Margin="5" Click="BtnStop_Click" IsEnabled="False"/>
            <Button x:Name="btnReset" Content="НОВЫЙ РАУНД" Width="120" Height="40" Margin="5" Click="BtnReset_Click"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Margin="10" Padding="10">
            <TextBlock x:Name="txtResult" 
                       Text="Нажимай и отдавай деньги" 
                       FontSize="14" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center"
                       Background="White"/>
        </Border>

        <CheckBox x:Name="chkPriorities" 
                  Grid.Row="4" 
                  Content="Установить разные приоритеты потоков" 
                  HorizontalAlignment="Center" 
                  Margin="10"
                  IsChecked="True"/>
    </Grid>
</Window>